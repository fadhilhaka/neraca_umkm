<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_neraca_umkm" model="ir.module.category">
        <field name="name">Neraca UMKM</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_neraca_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_neraca_umkm"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_neraca_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_neraca_umkm"/>
        <field name="implied_ids" eval="[(4, ref('group_neraca_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

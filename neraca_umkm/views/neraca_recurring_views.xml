<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_neraca_recurring_list" model="ir.ui.view">
        <field name="name">neraca.recurring.list</field>
        <field name="model">neraca.recurring</field>
        <field name="arch" type="xml">
            <list string="Transaksi Berulang"
                  decoration-muted="not active">
                <field name="name"/>
                <field name="recurring_type"/>
                <field name="amount"/>
                <field name="wallet_id"/>
                <field name="category_id" optional="show"/>
                <field name="frequency"/>
                <field name="interval" optional="hide"/>
                <field name="next_date"/>
                <field name="last_run_date" optional="show"/>
                <field name="active" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_neraca_recurring_form" model="ir.ui.view">
        <field name="name">neraca.recurring.form</field>
        <field name="model">neraca.recurring</field>
        <field name="arch" type="xml">
            <form string="Transaksi Berulang">
                <header>
                    <button name="action_run_now" type="object"
                            string="Jalankan Sekarang"
                            class="btn-primary"
                            confirm="Buat jurnal entri untuk tanggal hari ini?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Nonaktif" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Contoh: Sewa toko"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="recurring_type"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="wallet_id"/>
                            <field name="journal_id"/>
                            <field name="category_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="frequency"/>
                            <field name="interval"/>
                            <field name="next_date"/>
                            <field name="day_of_month"
                                     invisible="frequency != 'monthly'"/>
                            <field name="last_run_date"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Catatan">
                        <field name="notes" nolabel="1" placeholder="Catatan..."/>
                    </group>
                    <notebook>
                        <page string="Log Eksekusi" name="runs">
                            <field name="run_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="run_date"/>
                                    <field name="move_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_neraca_recurring_search" model="ir.ui.view">
        <field name="name">neraca.recurring.search</field>
        <field name="model">neraca.recurring</field>
        <field name="arch" type="xml">
            <search string="Berulang">
                <field name="name"/>
                <field name="wallet_id"/>
                <field name="category_id"/>
                <filter name="active" string="Aktif" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Nonaktif" domain="[('active', '=', False)]"/>
                <filter name="out" string="Keluar" domain="[('recurring_type', '=', 'out')]"/>
                <filter name="in" string="Masuk" domain="[('recurring_type', '=', 'in')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Arah" context="{'group_by': 'recurring_type'}"/>
                    <filter name="group_freq" string="Frekuensi" context="{'group_by': 'frequency'}"/>
                    <filter name="group_wallet" string="Dompet" context="{'group_by': 'wallet_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_neraca_recurring" model="ir.actions.act_window">
        <field name="name">Berulang</field>
        <field name="res_model">neraca.recurring</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Jadwalkan transaksi berulang
            </p>
            <p>
                Contoh: sewa toko bulanan, gaji karyawan, langganan software.
                Cron harian akan membuat jurnal entri otomatis.
            </p>
        </field>
    </record>
</odoo>

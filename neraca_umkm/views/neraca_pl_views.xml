<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_neraca_pl_report_form" model="ir.ui.view">
        <field name="name">neraca.pl.report.form</field>
        <field name="model">neraca.pl.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Laba Rugi UMKM">
                <header>
                    <button name="action_compute" type="object" string="Hitung Ulang"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Laporan Laba Rugi UMKM</h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_type" widget="radio"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Ringkasan">
                            <field name="amount_income"/>
                            <field name="amount_expense"/>
                            <field name="amount_net"
                                     decoration-success="amount_net &gt;= 0"
                                     decoration-danger="amount_net &lt; 0"
                                     class="fw-bold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rincian" name="lines">
                            <field name="line_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="section"/>
                                    <field name="account_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_neraca_pl" model="ir.actions.server">
        <field name="name">Laporan Laba Rugi UMKM</field>
        <field name="model_id" ref="model_neraca_pl_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_pl()</field>
    </record>
</odoo>
